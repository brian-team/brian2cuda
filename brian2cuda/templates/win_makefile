PROGRAM = main.exe
NVCC = {{nvcc_invocation}}

NVCCFLAGS = -I. -I{{cuda_include_quoted}} -std=c++17 {{gpu_arch_flags}} {{nvcc_compiler_flags}} {{compiler_debug_flags}} -Xcompiler "/permissive /EHsc /Zc:preprocessor /std:c++17 /Od /w"
LDFLAGS   = {{gpu_arch_flags}} {{cpp_linker_flags}} {{linker_debug_flags}}

LIBS = "{{cuda_lib_quoted}}\cudart.lib" "{{cuda_lib_quoted}}\curand.lib"

OBJS = {% for base in source_bases | sort %} {{base}}.obj {% endfor %}


all: $(PROGRAM)

{% for fname, base in zip(source_files, source_bases) | sort(attribute = '0') %}
{{base}}.obj: win_makefile {{fname}}
	$(NVCC) $(NVCCFLAGS) -dc {{fname}} -o {{base}}.obj
{% endfor %}

$(PROGRAM): win_makefile sourcefiles.txt $(OBJS)
	$(NVCC) $(LDFLAGS) $(OBJS) -o $(PROGRAM) $(LIBS)

clean:
	del /Q /S *.obj $(PROGRAM) sourcefiles.txt 2>nul

.PHONY: all clean
