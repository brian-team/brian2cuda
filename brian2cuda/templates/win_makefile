PROGRAM = main.exe
NVCC = {{nvcc_invocation}}

NVCCFLAGS = -I. -I{{cuda_include_quoted}} -std=c++17 --threads=0 {{gpu_arch_flags}} {{nvcc_compiler_flags}} -allow-unsupported-compiler -Xcompiler "/permissive /EHsc /Zc:preprocessor /std:c++17 /DWIN32_LEAN_AND_MEAN {{cpp_compiler_flags}} {{compiler_debug_flags}}"
LDFLAGS   = {{gpu_arch_flags}} {{linker_debug_flags}}

LIBS = "{{cuda_lib_path}}\cudart.lib" "{{cuda_lib_path}}\curand.lib"

OBJS = {% for base in source_bases | sort %} {{base}}.obj {% endfor %}


all: $(PROGRAM)

{% for fname, base in zip(source_files, source_bases) | sort(attribute = '0') %}
{{base}}.obj: win_makefile {{fname}}
	$(NVCC) $(NVCCFLAGS) -dc {{fname}} -o {{base}}.obj
{% endfor %}

$(PROGRAM): win_makefile $(OBJS)
	$(NVCC) $(LDFLAGS) $(OBJS) -o $(PROGRAM) $(LIBS)

clean:
	del /Q /S *.obj $(PROGRAM) 2>nul

.PHONY: all clean
